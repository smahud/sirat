# SIRAT — Environment Variables (template, tanpa secret)
# Salin sebagai .env dan isi nilai produksi. .env WAJIB chmod 0600 dan JANGAN commit.

# --- Database ---
# PostgreSQL produksi. Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://sirat:CHANGE_ME@127.0.0.1:5432/sirat?schema=public

# --- Session / JWT ---
# Min 32 karakter acak. Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_BASE64

# --- Aplikasi ---
NODE_ENV=production
PORT=3901
# Host yang diizinkan oleh Next.js (atau * bila di belakang reverse proxy tepercaya)
HOSTNAME=0.0.0.0

# --- Storage arsip ---
# Root penyimpanan arsip. Harus di luar web root, idealnya di volume/mount terpisah.
SIRAT_ARCHIVE_ROOT=/var/lib/sirat/archive
# Root staging untuk upload (akan dipindahkan ke ARCHIVE_ROOT setelah validasi).
SIRAT_STAGING_ROOT=/var/lib/sirat/staging
# Root artefak backup (exports/safety/tmp) — restore-upload juga di staging root.
SIRAT_BACKUP_ROOT=/var/lib/sirat/backups

# --- Batas upload ---
# Default 25 MiB per Blueprint 16.3. Samakan dengan batas reverse proxy.
SIRAT_MAX_FILE_BYTES=26214400

# --- Admin bootstrap (sekali pakai, hapus setelah admin dibuat) ---
# Bila kosong, password acak akan di-generate dan dicetak SEKALI ke stdout.
SIRAT_ADMIN_USERNAME=admin
# SIRAT_ADMIN_PASSWORD=     # kosongkan untuk auto-generate; isi via kanal secret

# --- Audit log (opsional) ---
# SIRAT_AUDIT_LOG_FILE=/var/log/sirat/audit.log
